/* =========================================================================
   app.tcss — Single source of truth for all application styles.

   Sections:
     1. Layout (frame, panels, tables)
     2. Overlays & overlays
     3. ConfirmDialog  (migrated from widgets.py DEFAULT_CSS)
     4. LogPane        (migrated from widgets.py DEFAULT_CSS)
     5. Toast          (ansi-dark/ansi-light contrast fix)
   ========================================================================= */


/* ---- Frame -------------------------------------------------------------- */

TopBar {
    dock: top;
    height: 1;
    width: 100%;
    padding: 0 1;
    background: $background;
}

BottomBar {
    dock: bottom;
    height: 1;
    width: 100%;
    padding: 0 1;
    background: $background;
}

#main-container {
    height: 1fr;
    padding: 1 1 0 1;
}

/* ---- Compact (80x24): see 06-compact. Every row counts. ---------------- */

.-compact BottomBar {
    height: 2;
}

.-compact #main-container {
    padding: 0 1;
}

/* The filter row is hidden until `/` or an active query shows it. */
.-compact #list-toolbar {
    display: none;
}

.-compact.-filtering #list-toolbar {
    display: block;
}


.panel {
    border: round $border;
    border-title-color: $text-muted;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

.panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

/* Min widths are deliberately small so 80 columns stays usable; the real
   narrow-terminal layout is the compact mode (phase 06). */
#list-panel {
    width: 2fr;
    min-width: 40;
    height: 100%;
}

#side-column {
    width: 1fr;
    min-width: 30;
    height: 100%;
    margin-left: 2;
}

#side-column > .panel {
    height: 1fr;
}

/* Four rows of sparklines/gauge; hidden for rows that aren't running containers. */
#side-column > #live-panel {
    height: auto;
}

/* The card gets twice the room of the logs panel under it. */
#side-column > #detail-pane {
    height: 2fr;
}

/* Networks: a compact card on top, the bus diagram sized to its content (but
   never more than half the column), and the endpoints table taking the rest. */
#side-column.-networks > #detail-pane {
    height: auto;
    max-height: 12;
}

#side-column.-networks > #topology-panel {
    height: auto;
    max-height: 55%;
}

/* The one place a border carries status (design board 6 says it never does):
   `safe to delete` is destructive advice, so its border stays `warning`. It is
   the card's whole point, and it only shows for an orphaned volume. */
#side-column > .panel.-warning {
    height: auto;
    border: round $warning;
    border-title-color: $warning;
}

/* Full-view logs: the list is hidden, so the side column takes the width. */
#side-column.logs-full {
    margin-left: 0;
}

#side-column.logs-full > LogPane {
    height: 100%;
}

ToolbarLine {
    height: 1;
    width: 100%;
    background: $background;
}

#list-toolbar {
    height: 1;
    margin-bottom: 1;
}

#search-bar {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $background;
}

#search-bar:focus {
    border: none;
    background: $surface;
}

ChipBar {
    width: auto;
    height: 1;
}

/* The tab strip lives in the top bar; TabbedContent keeps owning `.active`. */
TabbedContent > Tabs {
    display: none;
}

/* Height configuration for tab content and tables. */
TabbedContent {
    height: 1fr;
}

TabbedContent ContentSwitcher {
    height: 1fr;
}

TabbedContent TabPane {
    height: 100%;
    padding: 0;
}

TabbedContent DataTable {
    height: 100%;
    background: $background;
}

DataTable > .datatable--header {
    color: $text-muted;
    text-style: none;
    background: $background;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

#detail-pane {
    padding: 0 1;
}

/* `▸` sections under MORE: one compact row each, body indented when open. */
#detail-pane Collapsible {
    border-top: none;
    padding: 0;
}

#detail-pane Collapsible > Contents {
    padding: 0 0 0 2;
}

.muted {
    color: $text-muted;
}

#refresh-loading {
    display: none;
    overlay: screen;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $surface 35%;
}

.empty-state {
    display: none;
    height: 100%;
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    text-align: center;
    padding: 2;
}

#connection-banner {
    display: none;
    dock: top;
    margin-top: 1; /* Leaves room for the top bar */
    width: 100%;
    height: auto;
    background: $error;
    color: $text;
    text-align: center;
    padding: 0 1;
}


ConfirmDialog {
    align: center middle;
}

ConfirmDialog > Vertical {
    width: 62;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 2 4;
}

ConfirmDialog Label {
    text-align: center;
    width: 100%;
    margin-bottom: 2;
}

ConfirmDialog Horizontal {
    align: center middle;
    height: auto;
}

ConfirmDialog Checkbox {
    align: center middle;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

ConfirmDialog Button {
    margin: 0 2;
}


LogPane {
    width: 100%;
    height: 1fr;
}

LogPane #log-pane-view {
    height: 1fr;
    padding: 0 1;
}

/* Text-selection highlight (drag-select in the log pane). Only the background
   is used (SelectableRichLog keeps each line's own fg), and the percentage
   makes it translucent — Textual blends it over the theme background to a solid
   tint, so the original coloured text stays readable through the highlight.
   Bump the percentage for a stronger highlight, or swap $accent for a colour. */
Screen > .screen--selection {
    background: $accent 40%;
}

