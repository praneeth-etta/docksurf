    background: $background 60%;
}

HelpScreen > Vertical {
    width: 70;
    height: 85%;
    border: double $accent;
    background: $surface;
    padding: 1 3;
}

HelpScreen #help-title {
    text-align: center;
    width: 100%;
    margin-bottom: 0;
    color: $accent;
    text-style: bold;
}

HelpScreen VerticalScroll {
    height: 1fr;
    border: solid $primary-background-lighten-2;
}

HelpScreen Static{
    margin: 1 0;
}

HelpScreen Button {
    margin-top: 1;
    width: 100%;
}

