Toast:ansi:dark {
    color: ansi_white;
}

Toast:ansi:light {
    color: ansi_black;
}

Toast:ansi:dark .toast--title {
    color: ansi_white;
}

Toast:ansi:light .toast--title {
    color: ansi_black;
}